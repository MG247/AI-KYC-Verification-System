# ProjectKYC backend environment
# Copy this file to backend/.env and fill in local values. Never commit backend/.env.
# Local PaddleOCR works without Azure credentials.

# ---- Azure OpenAI (optional: LLM review + GPT Vision OCR) --------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- LLM review / network options --------------------------------------
KYC_LLM_ENABLE=true
KYC_LLM_CA_BUNDLE=
KYC_LLM_INSECURE_SKIP_VERIFY=false

# ---- Logging ------------------------------------------------------------
KYC_LOG_LEVEL=INFO
KYC_LOG_FORMAT=console

# ---- Audit storage ------------------------------------------------------
KYC_AUDIT_REDIS_URL=
KYC_AUDIT_FILE=audit.jsonl
KYC_AUDIT_TTL_SECONDS=604800

# ---- KYC OCR engine -----------------------------------------------------
KYC_OCR_PADDLE_LANG=en
KYC_OCR_PADDLE_USE_TEXTLINE_ORIENTATION=true
KYC_OCR_PADDLE_USE_DOC_ORIENTATION_CLASSIFY=false
KYC_OCR_PADDLE_USE_DOC_UNWARPING=false
KYC_OCR_PADDLE_USE_GPU=false
# Explicit override; takes precedence over KYC_OCR_PADDLE_USE_GPU when set.
# Examples: cpu, gpu:0
# KYC_OCR_PADDLE_DEVICE=cpu
KYC_OCR_PADDLE_CPU_THREADS=4
KYC_OCR_PADDLE_TEXT_DET_BOX_THRESH=0.60
KYC_OCR_PADDLE_TEXT_REC_SCORE_THRESH=0.60
KYC_OCR_PADDLE_OCR_VERSION=PP-OCRv4

# Optional secondary fallback. Off unless you have validated EasyOCR locally.
KYC_OCR_ENABLE_EASYOCR_FALLBACK=false

# I/O limits and security
KYC_OCR_MAX_FILE_SIZE_MB=15
KYC_OCR_MAX_PDF_PAGES=20
KYC_OCR_PDF_RENDER_DPI=300

# Preprocessing
KYC_OCR_TARGET_LONG_EDGE_PX=1600
KYC_OCR_BLUR_VARIANCE_THRESHOLD=80
KYC_OCR_MIN_IMAGE_DIM_PX=200
KYC_OCR_ENABLE_DENOISE=true
KYC_OCR_ENABLE_CLAHE=true

# Caching and concurrency
KYC_OCR_ENABLE_RESULT_CACHE=true
KYC_OCR_RESULT_CACHE_SIZE=512
KYC_OCR_OCR_EXECUTOR_WORKERS=4

# Retry and confidence
KYC_OCR_RETRY_MAX_ATTEMPTS=3
KYC_OCR_RETRY_BASE_DELAY_S=0.25
KYC_OCR_LOW_CONFIDENCE_THRESHOLD=0.70
KYC_OCR_SUSPICIOUS_CONFIDENCE_THRESHOLD=0.55
KYC_OCR_MIN_KEEP_CONFIDENCE=0.55
